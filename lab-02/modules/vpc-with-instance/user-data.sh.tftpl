#!/bin/bash
# Serve a one-line page on port 80 that says which VPC answered
mkdir -p /srv/www
echo "hello from ${label} - $(hostname -I | awk '{print $1}')" > /srv/www/index.html

cat > /etc/systemd/system/hello-web.service <<'EOF'
[Unit]
Description=Peering lab test page
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 80 --directory /srv/www
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now hello-web
